{
  "name": "url-shortner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply url-shortner --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "@trpc/client": "11.24.0",
    "@trpc/server": "11.24.0",
    "@trpc/tanstack-react-query": "11.24.0",
    "client-only": "^0.0.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  },
  "packageManager": "pnpm@11.9.0"
}
